{
	"compatibility_date": "2026-05-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "hankadev-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "hankadev.com",
			"custom_domain": true
		},
		{
			"pattern": "www.hankadev.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}