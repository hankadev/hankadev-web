---
import BaseLayout from "../layouts/BaseLayout.astro";
import TalkListCards from "../components/TalkListCards.astro";
import { talks } from "../data/talks";
---

<BaseLayout pageTitle="hankadev talks">
  <section class="mx-auto max-w-5xl">
    <h1 class="text-center">Transmission Log</h1>
    <p class="mt-3 mb-8 text-center text-text-muted">
      Meetups, conferences, and recorded sessions from the Outer Rim
      Territories.
    </p>
  </section>

  <TalkListCards talks={talks} />
</BaseLayout>
