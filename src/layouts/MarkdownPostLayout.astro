---
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import { Icon } from "astro-icon/components";
import { formatPublishDate } from "../utils/date.js";

const { frontmatter, minutesRead } = Astro.props;
const formattedPublishDate = formatPublishDate(frontmatter.publishDate);
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="blog-post max-w-4xl p-8 flex flex-col m-auto">
    <h1 class="text-primary text-center font-semibold">
      {frontmatter.title}
    </h1>
    <div class="mt-4 mb-8 flex flex-col items-center gap-3">
      <div class="flex flex-wrap justify-center gap-2">
        {frontmatter.tags.map((tag: string) => <Tag tag={tag} isLink />)}
      </div>
      <div class="text-accent font-semibold flex items-center gap-2">
        <Icon name="lucide:calendar-days" />
        <time datetime={frontmatter.publishDate.toISOString()}>
          {formattedPublishDate}
        </time>
        {
          minutesRead && (
            <>
              <span aria-hidden="true">•</span>
              <Icon name="lucide:timer" />
              <span>{minutesRead}</span>
            </>
          )
        }
      </div>
      <slot />
    </div>
  </article>
</BaseLayout>
